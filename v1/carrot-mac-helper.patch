@@ -0,0 +1,15 @@
+#!/usr/bin/env bash
+set -euo pipefail
+ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
+[[ "$(uname -s)" == Darwin ]] || { echo 'macOS required' >&2; exit 1; }
+command -v brew >/dev/null || { echo 'Install Homebrew first: https://brew.sh' >&2; exit 1; }
+brew install python@3.12 libusb ffmpeg
+# Only schema files from the pinned submodule are needed; no device binaries.
+git -C "$ROOT" submodule update --init --depth 1 opendbc_repo
+"$(brew --prefix python@3.12)/bin/python3.12" -m venv "$ROOT/.mac-hud-venv"
+"$ROOT/.mac-hud-venv/bin/python" -m pip install --upgrade pip
+"$ROOT/.mac-hud-venv/bin/python" -m pip install 'numpy>=1.26,<3' \
+  -r "$ROOT/openpilot/selfdrive/carrot/cluster/requirements.txt"
+export PYTHONPATH="$ROOT"
+"$ROOT/.mac-hud-venv/bin/python" "$ROOT/tools/jetlink/hud.py" --help >/dev/null
+echo 'HUD dependencies ready. Run tools/jetlink/run_mac_hud.sh.'
