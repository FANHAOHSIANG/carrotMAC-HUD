diff --git a/tools/jetlink/hud_runtime.py b/tools/jetlink/hud_runtime.py
new file mode 100644
index 0000000..3abc6c2
--- /dev/null
+++ b/tools/jetlink/hud_runtime.py
@@ -0,0 +1,12 @@
+"""Host-only paths; Linux retains the original Jetson locations."""
+import os
+from pathlib import Path
+import sys
+
+MAC = sys.platform == 'darwin'
+DIRECTORY = (Path(os.environ.get('CARROT_HUD_DIR',
+  str(Path.home() / 'Library/Caches/io.zoompilot.jetlink/carrot-hud')))
+  if MAC else Path('/dev/shm'))
+PACKET = DIRECTORY / ('snapshot.packet' if MAC else 'carrot-jetlink-hud.packet')
+STATUS = DIRECTORY / ('status.json' if MAC else 'carrot-jetlink-hud-status.json')
+NAVI_ADDRESS = ('127.0.0.1', 47741) if MAC else '\0carrot-jetlink-navi'
diff --git a/tools/jetlink/run_mac_hud.sh b/tools/jetlink/run_mac_hud.sh
new file mode 100755
index 0000000..c9c5734
--- /dev/null
+++ b/tools/jetlink/run_mac_hud.sh
@@ -0,0 +1,22 @@
+#!/usr/bin/env bash
+set -euo pipefail
+trap 'exit 130' INT
+trap 'exit 143' TERM
+ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
+RUNTIME="$ROOT/.mac-hud-venv"
+if [[ "$(uname -s)" != Darwin ]]; then
+  echo 'This launcher requires macOS.' >&2
+  exit 1
+fi
+if [[ ! -x "$RUNTIME/bin/python" ]]; then
+  echo 'Run tools/jetlink/setup_mac_hud.sh first.' >&2
+  exit 1
+fi
+export PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}"
+# Homebrew is often missing from a Finder-launched app's PATH.
+export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
+while true; do
+  "$RUNTIME/bin/python" "$ROOT/tools/jetlink/hud.py" "$@" && exit 0
+  echo 'HUD stopped; retrying in 2 seconds. Ctrl-C stops this helper.' >&2
+  sleep 2
+done
