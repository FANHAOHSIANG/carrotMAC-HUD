diff --git a/tools/jetlink/test_mac_hud.py b/tools/jetlink/test_mac_hud.py
new file mode 100644
index 0000000..338da5b
--- /dev/null
+++ b/tools/jetlink/test_mac_hud.py
@@ -0,0 +1,65 @@
+"""Portable tests of the Mac clock and IPC adapters (no USB hardware)."""
+import json
+from pathlib import Path
+import socket
+import sys
+import time
+
+import pytest
+
+sys.path.insert(0, str(Path(__file__).parent))
+import hud_protocol as protocol
+import hud_navi as navi
+
+
+@pytest.mark.parametrize('age,valid', [(0.1, True), (0.499, True), (0.5, False), (5., False), (-1., False)])
+def test_epoch_clock_translation_and_expiry(tmp_path, monkeypatch, age, valid):
+  packet = tmp_path / 'snapshot.packet'
+  packet.write_bytes(protocol.HEADER.pack(1000. - age) + json.dumps({'version': 1}).encode())
+  monkeypatch.setattr(protocol, 'MAC', True)
+  monkeypatch.setattr(protocol, 'HUD_PACKET', packet)
+  monkeypatch.setattr(protocol, '_next_snapshot_read', 0.)
+  monkeypatch.setattr(protocol.time, 'time', lambda: 1000.)
+  monkeypatch.setattr(protocol.time, 'monotonic', lambda: 50.)
+  result = protocol.read_snapshot()
+  assert (result is not None) == valid
+  if valid:
+    assert result[0] == pytest.approx(50. - age)
+
+
+def test_mac_loopback_delivers_full_navigation_fragments(monkeypatch):
+  # macOS cannot use Linux's abstract AF_UNIX address. Exercise the actual
+  # replacement UDP transport with the existing ordered reassembler.
+  monkeypatch.setattr(navi, 'MAC', True)
+  monkeypatch.setattr(navi, 'ADDRESS', ('127.0.0.1', 0))
+  receiver = navi.RemoteMediaSocket()
+  monkeypatch.setattr(navi, 'ADDRESS', receiver.sock.getsockname())
+  forwarder = navi.HostForwarder()
+  raw = bytes(range(256)) * 300
+  try:
+    complete = None
+    for fragment in navi.fragments(raw, 1, 2):
+      forwarder.send(fragment)
+      receiver.sock.settimeout(1)
+      complete = receiver.assembler.feed(receiver.sock.recv(navi.CHUNK + navi.HEADER.size + 1), time.monotonic())
+    assert complete == (1, 2, raw)
+  finally:
+    forwarder.close()
+    receiver.close()
+
+
+def test_missing_navigation_fragment_never_yields_partial_event():
+  assembler = navi.Assembler()
+  fragments = list(navi.fragments(b'x' * 100000, 1, 2))
+  assert assembler.feed(fragments[0], 1.) is None
+  assert assembler.feed(fragments[2], 1.1) is None
+  assert assembler.feed(fragments[3], 1.2) is None
+
+
+def test_disconnect_invalidates_all_vehicle_services(monkeypatch):
+  import hud
+  master = hud.RemoteSubMaster(['carState'])
+  master.valid['carState'] = master.alive['carState'] = True
+  monkeypatch.setattr(hud, 'read_snapshot', lambda: None)
+  master.update()
+  assert not master.valid['carState'] and not master.alive['carState']
