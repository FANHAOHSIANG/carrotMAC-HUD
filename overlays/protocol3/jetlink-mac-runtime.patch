@@ -364,6 +364,16 @@ public final class EngineHost: @unchecked Sendable {
   private func start(_ job: Job, request: Request, entry: CacheEntry, modelPath: URL, spec: ModelSpec?) {
     job.detail = job.loadOnly ? "loading engine" : "building engine"
     lock.lock()
+    // request/preload inspect the disk without holding the inference lock.
+    // Another caller may have started (or finished) the same load meanwhile.
+    // Reserve the job atomically before launching a worker: two workers can
+    // otherwise unload each other's engine and write the same artifact.
+    if self.job?.state == .building
+      || (loaded?.sha256 == request.sha256 && loaded?.spec.frameSkip == request.frameSkip)
+    {
+      lock.unlock()
+      return
+    }
     self.job = job
     // The stage belongs to the job: a fresh job must not show the last one's 100 %.
     lastStage = (nil, 0, "")
