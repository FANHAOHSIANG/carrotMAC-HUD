diff --git a/JetlinkKit/Tests/JetlinkServerTests/CarrotHUDTests.swift b/JetlinkKit/Tests/JetlinkServerTests/CarrotHUDTests.swift
new file mode 100644
index 0000000..64bc5fc
--- /dev/null
+++ b/JetlinkKit/Tests/JetlinkServerTests/CarrotHUDTests.swift
@@ -0,0 +1,110 @@
+#if os(macOS)
+import Foundation
+import Darwin
+import Testing
+import JetlinkKit
+import JetlinkTestSupport
+@testable import JetlinkServer
+
+@Suite("Carrot display extension", .serialized)
+struct CarrotHUDTests {
+  @Test("Snapshot is little-endian epoch + JSON; last sample is bounded and fresh")
+  func packet() throws {
+    let bridge = CarrotHUD.shared
+    let id = UUID()
+    #expect(bridge.claim(id))
+    defer { bridge.release(id) }
+    let path = CarrotHUD.directory.appendingPathComponent("snapshot.packet")
+    try? FileManager.default.removeItem(at: path)
+    let payload = try JSONSerialization.data(withJSONObject: [
+      "version": 1, "sent": 10.0, "events": [:], "params": [:],
+      "valid": [:], "alive": [:], "received": [:], "mono": [:],
+    ] as [String: Any])
+    payload.withUnsafeBytes { bridge.accept($0, owner: id) }
+    let deadline = Date().addingTimeInterval(2)
+    while !FileManager.default.fileExists(atPath: path.path), Date() < deadline {
+      Thread.sleep(forTimeInterval: 0.01)
+    }
+    let bytes = try Data(contentsOf: path)
+    let bits = bytes.withUnsafeBytes { UInt64(littleEndian: $0.loadUnaligned(as: UInt64.self)) }
+    #expect(abs(Date().timeIntervalSince1970 - Double(bitPattern: bits)) < 2)
+    #expect(bytes.dropFirst(8) == payload)
+    #expect(!bridge.claim(UUID()))
+  }
+
+  @Test("Stale or disconnected helper cannot claim a connected display")
+  func telemetry() throws {
+    let path = CarrotHUD.directory.appendingPathComponent("status.json")
+    try FileManager.default.createDirectory(at: CarrotHUD.directory, withIntermediateDirectories: true)
+    defer { try? FileManager.default.removeItem(at: path) }
+    for (age, connected, expected) in [(0.1, true, true), (4.0, true, false), (0.1, false, false)] {
+      let bytes = try JSONSerialization.data(withJSONObject: ["updated_epoch": Date().timeIntervalSince1970 - age, "connected": connected])
+      try bytes.write(to: path, options: .atomic)
+      #expect(CarrotHUD.telemetry()["carrot_hud_connected"] as? Bool == expected)
+    }
+  }
+  @Test("Protocol 3 HELLO advertises HUD, display packets are silent and replay guarded")
+  func session() throws {
+    let temp = try TemporaryDirectory()
+    let cache = try ServerCache(root: temp.url, backend: cpuBackend())
+    let host = EngineHost(cache: cache)
+    defer { host.close() }
+    let link = CarrotTestLink()
+    let session = Session(transport: link, host: host)
+    defer { session.close() }
+    let path = CarrotHUD.directory.appendingPathComponent("snapshot.packet")
+    try? FileManager.default.removeItem(at: path)
+    let payload = try JSONSerialization.data(withJSONObject: [
+      "version": 1, "sent": 10.0, "events": [:], "params": [:],
+      "valid": [:], "alive": [:], "received": [:], "mono": [:],
+    ] as [String: Any])
+    func deliver(_ type: UInt16, _ seq: UInt32, _ data: Data = Data()) throws {
+      try data.withUnsafeBytes {
+        try session.handle(Message(msgType: type, seq: seq, flags: 0, payload: $0))
+      }
+    }
+    try deliver(CarrotHUD.hudType, 1, payload)
+    #expect(link.replies.isEmpty)
+    #expect(!FileManager.default.fileExists(atPath: path.path))
+    try deliver(Wire.Msg.helloReq.rawValue, 2, Data("{\"client\":{\"name\":\"carrot-jetlink/test\"}}".utf8))
+    let hello = try #require(link.replies.last).json
+    #expect(hello["protocol"] as? Int == 3)
+    #expect(hello["carrot_hud_v1"] as? Bool == true)
+    #expect(hello["carrot_navi_v1"] as? Bool == true)
+    #expect(hello["carrot_host"] as? String == "mac")
+    try deliver(CarrotHUD.hudType, 2, payload) // replay must not write
+    #expect(!FileManager.default.fileExists(atPath: path.path))
+    try deliver(CarrotHUD.hudType, 3, payload)
+    let deadline = Date().addingTimeInterval(2)
+    while !FileManager.default.fileExists(atPath: path.path), Date() < deadline {
+      Thread.sleep(forTimeInterval: 0.01)
+    }
+    #expect(FileManager.default.fileExists(atPath: path.path))
+    #expect(link.replies.count == 1) // display has no extra reply
+    try deliver(Wire.Msg.ping.rawValue, 4)
+    #expect(link.replies.last?.type == Wire.Msg.pong.rawValue)
+    // Idle offroad HELLO releases the model request without losing HUD ownership.
+    try deliver(Wire.Msg.helloReq.rawValue, 5, Data("{}".utf8))
+    #expect(link.replies.last?.json["carrot_hud_v1"] as? Bool == true)
+    session.close()
+    let nextOwner = UUID()
+    #expect(CarrotHUD.shared.claim(nextOwner))
+    CarrotHUD.shared.release(nextOwner)
+  }
+
+}
+private final class CarrotTestLink: MessageLink, @unchecked Sendable {
+  var peer: String { "carrot-test" }
+  var medium: LinkMedium? { .usb3 }
+  var connectsOnOpen: Bool { true }
+  var replies: [Reply] = []
+  func recv() throws -> Message { throw LinkError.closed("test link") }
+  func sendParts(_ type: Wire.Msg, seq: UInt32, parts: UnsafeBufferPointer<UnsafeRawBufferPointer>, flags: Wire.Flag) throws {
+    var payload = Data()
+    for part in parts { payload.append(contentsOf: part) }
+    replies.append(Reply(type: type.rawValue, seq: seq, payload: payload))
+  }
+  func shutdown() {}
+  func close() {}
+}
+#endif
