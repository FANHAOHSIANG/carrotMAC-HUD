@@ -0,0 +1,128 @@
+#if os(macOS)
+import Foundation
+import Darwin
+
+/// Optional display-only Carrot extension. One pending snapshot, never a FIFO
+/// of disk writes. No acknowledgement: Carrot sends these between model RPCs.
+final class CarrotHUD: @unchecked Sendable {
+  static let shared = CarrotHUD()
+  static let hudType: UInt16 = 0x4000
+  static let naviType: UInt16 = 0x4001
+  static let maxBytes = 512 * 1024
+  static let directory: URL = {
+    if let path = ProcessInfo.processInfo.environment["CARROT_HUD_DIR"] {
+      return URL(fileURLWithPath: path, isDirectory: true)
+    }
+    return FileManager.default.homeDirectoryForCurrentUser
+      .appendingPathComponent("Library/Caches/io.zoompilot.jetlink/carrot-hud", isDirectory: true)
+  }()
+
+  private let condition = NSCondition()
+  private var owner: UUID?
+  private var pending: (UUID, Double, Data)?
+  private let udp: Int32
+  private let log = ServerLog(category: "carrot-hud")
+
+  private init() {
+    udp = Darwin.socket(AF_INET, SOCK_DGRAM, 0)
+    if udp >= 0 { _ = fcntl(udp, F_SETFL, O_NONBLOCK) }
+    let thread = Thread { [self] in run() }
+    thread.name = "carrot-hud-writer"
+    thread.qualityOfService = .utility
+    thread.start()
+  }
+
+  func claim(_ id: UUID) -> Bool {
+    condition.lock()
+    defer { condition.unlock() }
+    guard owner == nil || owner == id else { return false }
+    owner = id
+    pending = nil
+    return true
+  }
+
+  func release(_ id: UUID) {
+    condition.lock()
+    if owner == id { owner = nil; pending = nil }
+    condition.unlock()
+    // Snapshot age expires in 0.5s even if an in-flight write just finished.
+  }
+
+  func accept(_ payload: UnsafeRawBufferPointer, owner id: UUID) {
+    guard !payload.isEmpty, payload.count <= Self.maxBytes else { return }
+    let stamp = Date().timeIntervalSince1970
+    let copy = Data(payload)
+    condition.lock()
+    if owner == id {
+      pending = (id, stamp, copy)
+      condition.signal()
+    }
+    condition.unlock()
+  }
+
+  func forward(_ payload: UnsafeRawBufferPointer, owner id: UUID) {
+    guard udp >= 0, payload.count > 24, payload.count <= 24 + 32 * 1024 else { return }
+    condition.lock()
+    let allowed = owner == id
+    condition.unlock()
+    guard allowed else { return }
+    // Loopback IPC only: macOS has no Linux abstract Unix socket namespace.
+    var address = sockaddr_in()
+    address.sin_len = UInt8(MemoryLayout<sockaddr_in>.size)
+    address.sin_family = sa_family_t(AF_INET)
+    address.sin_port = UInt16(47741).bigEndian
+    address.sin_addr.s_addr = inet_addr("127.0.0.1")
+    withUnsafePointer(to: &address) { pointer in
+      pointer.withMemoryRebound(to: sockaddr.self, capacity: 1) {
+        _ = Darwin.sendto(udp, payload.baseAddress, payload.count, 0, $0,
+                          socklen_t(MemoryLayout<sockaddr_in>.size))
+      }
+    }
+  }
+
+  /// Called only by the telemetry worker, never on the inference thread.
+  static func telemetry() -> [String: Any] {
+    let path = directory.appendingPathComponent("status.json")
+    guard let bytes = try? Data(contentsOf: path), bytes.count <= 4096,
+          let record = (try? JSONSerialization.jsonObject(with: bytes)) as? [String: Any],
+          let updated = record["updated_epoch"] as? Double,
+          (0..<3).contains(Date().timeIntervalSince1970 - updated),
+          record["connected"] as? Bool == true else {
+      return ["carrot_hud_connected": false]
+    }
+    return ["carrot_hud_connected": true]
+  }
+
+  private func run() {
+    var nextError = 0.0
+    while true {
+      condition.lock()
+      while pending == nil { condition.wait() }
+      let (id, received, payload) = pending!
+      pending = nil
+      let allowed = owner == id
+      condition.unlock()
+      guard allowed, (0..<0.5).contains(Date().timeIntervalSince1970 - received) else { continue }
+      do {
+        guard let record = try JSONSerialization.jsonObject(with: payload) as? [String: Any],
+              record["version"] as? Int == 1,
+              record["sent"] is NSNumber,
+              ["events", "params", "valid", "alive", "received", "mono"].allSatisfy({ record[$0] is [String: Any] }) else { continue }
+        try FileManager.default.createDirectory(at: Self.directory, withIntermediateDirectories: true,
+                                                attributes: [.posixPermissions: 0o700])
+        var stamp = received.bitPattern.littleEndian
+        var packet = Data()
+        withUnsafeBytes(of: &stamp) { packet.append(contentsOf: $0) }
+        packet.append(payload)
+        try packet.write(to: Self.directory.appendingPathComponent("snapshot.packet"), options: .atomic)
+      } catch {
+        let now = Date().timeIntervalSince1970
+        if now >= nextError {
+          log.error("HUD snapshot write failed: \(error)")
+          nextError = now + 5
+        }
+      }
+    }
+  }
+}
+#endif
