+    def _draw_navi_signal_badge(self, navi: NaviLiveState | None, x: float, y: float) -> bool:
+        signal = navi.traffic_light if navi is not None else None
+        if signal is None or signal.meta is None or (navi.status is not None and navi.status.off_route):
+            return False
+        age = time.monotonic() - signal.meta.received_mono_s
+        if not 0 <= age < 2.5:
+            return False
+        color = self._current_theme().text
+        seconds = signal.counter_s
+        arrow = ""
+        colored = False
+        if signal.source != "amap_link":
+            for active, remaining, lamp_color, direction in (
+                (signal.red_on, signal.red_s, NAVI_TRAFFIC_RED, ""),
+                (signal.left_on, signal.left_s, NAVI_TRAFFIC_GREEN, "← "),
+                (signal.straight_on, signal.straight_s, NAVI_TRAFFIC_GREEN, ""),
+                (signal.right_on, signal.right_s, NAVI_TRAFFIC_GREEN, "→ "),
+                (signal.uturn_on, signal.uturn_s, NAVI_TRAFFIC_GREEN, "↶ "),
+            ):
+                if active is True:
+                    seconds, color, arrow = remaining or seconds, lamp_color, direction
+                    colored = True
+                    break
+        if seconds is None or not 0 < seconds - int(age) <= 999:
+            return False
+        theme = self._current_theme()
+        self._rounded_rect(x, y - 15.0, 96.0, 30.0, 6.0, theme.panel_bg, theme.faint, 1.0)
+        if colored and not arrow:
+            rl.draw_circle_v(rl.Vector2(x + 17.0, y), 5.0, rl_color(color))
+        self._draw_text(f"{arrow}{seconds - int(age)} s", x + (54.0 if colored else 48.0), y, 21.0, color, anchor="center")
+        return True
+
+    def _draw_navi_summary_alerts(self, state: ClusterUiState, x: float, y: float) -> None:
+        navi = state.navi_live
+        if navi is None or (navi.status is not None and navi.status.off_route):
+            return
+        has_signal = self._draw_navi_signal_badge(navi, x, y)
+        speed = navi.speed
+        if speed is None or speed.meta is None or not 0 <= time.monotonic() - speed.meta.received_mono_s < 3.0:
+            return
+        if speed.section_active:
+            label = self._text("section")
+            limit = speed.section_speed_limit_kph
+            distance = speed.section_remaining_distance_m
+        else:
+            label = "SDI"
+            limit = speed.sdi_speed_limit_kph
+            distance = speed.sdi_distance_m
+            if speed.sdi_type in (None, -1, 22) or not limit:
+                limit, distance = speed.secondary_sdi_speed_limit_kph, speed.secondary_sdi_distance_m
+                if speed.secondary_sdi_type in (None, -1, 22):
+                    return
+        if not limit or distance is None or distance <= 0:
+            return
+        limit_text = f"{display_speed(limit, self.is_metric):.0f}"
+        message = f"{label} {limit_text} / {self._format_navi_distance(distance)}"
+        offset = 106.0 if has_signal else 0.0
+        self._draw_text(self._ellipsize_text(message, 19.0, 282.0 - offset), x + offset, y, 19.0, AMBER)
+
