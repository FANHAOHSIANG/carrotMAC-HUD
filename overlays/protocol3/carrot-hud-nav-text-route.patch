+    @staticmethod
+    @lru_cache(maxsize=2)
+    def _standalone_mac_font(path: Path) -> bytes:
+        """Copy the first face of a macOS collection into a standalone SFNT."""
+        data = path.read_bytes()
+        if data[:4] != b"ttcf":
+            return data
+        face = struct.unpack_from(">I", data, 12)[0]
+        count = struct.unpack_from(">H", data, face + 4)[0]
+        header_end = face + 12 + 16 * count
+        if not 0 < count <= 256 or header_end > len(data):
+            raise ValueError("Invalid macOS font table directory")
+        result = bytearray(data[face:header_end])
+        for index in range(count):
+            entry = 12 + 16 * index
+            offset, length = struct.unpack_from(">II", result, entry + 8)
+            if offset + length > len(data):
+                raise ValueError("Invalid macOS font table")
+            struct.pack_into(">I", result, entry + 8, len(result))
+            result.extend(memoryview(data)[offset:offset + length])
+            result.extend(b"\0" * (-len(result) % 4))
+        return bytes(result)
+
