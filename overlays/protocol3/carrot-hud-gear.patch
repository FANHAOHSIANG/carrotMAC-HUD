index 0000000000000000000000000000000000000000..1e6455d92df45e60a2d3774071b38e4e77d71738
--- /dev/null
+++ b/openpilot/selfdrive/carrot/cluster/cluster_gear_display.py
@@ -0,0 +1,278 @@
+"""P/R screens for the remote HUD. Vehicle telemetry is read-only."""
+from __future__ import annotations
+
+import math
+from pathlib import Path
+import time
+from typing import NamedTuple
+
+import pyray as rl
+
+from cluster_config import DESIGN_HEIGHT, DESIGN_WIDTH
+from cluster_display import cluster_text, display_speed, format_trip_distance, speed_unit
+
+
+ASSETS = Path(__file__).resolve().parent / "assets" / "parking"
+TRADITIONAL_CHINESE = "zh-TW"
+COLORS = {
+    False: {"top": (246, 247, 249), "bottom": (222, 225, 230), "text": (28, 31, 36),
+            "muted": (80, 88, 100), "card": (255, 255, 255), "line": (194, 201, 211), "accent": (0, 92, 206)},
+    True: {"top": (30, 33, 38), "bottom": (10, 11, 13), "text": (236, 238, 241),
+           "muted": (168, 174, 184), "card": (48, 52, 61), "line": (70, 77, 89), "accent": (104, 175, 255)},
+}
+
+class GearLabels(NamedTuple):
+    park: str
+    reverse: str
+    tyre_pressures: str
+    this_trip: str
+    steering_wheel: str
+    blind_spots: str
+    estimated_path: str
+    rear_view_reminder: str
+    centre: str
+    left: str
+    right: str
+
+
+LABELS = {
+    "en": GearLabels("Park", "Reverse", "Tyre pressures (psi)", "This trip", "Steering wheel", "Rear blind spots",
+                     "Estimated path", "Check rear camera and surroundings", "Centre", "Left", "Right"),
+    "ko": GearLabels("주차", "후진", "공기압 (psi)", "이번 주행", "핸들", "후측방",
+                     "예상 궤적", "후방 카메라와 주변을 함께 확인하세요", "가운데", "왼쪽", "오른쪽"),
+    TRADITIONAL_CHINESE: GearLabels("駐車", "倒車", "胎壓 (psi)", "本次行程", "方向盤角度", "後側盲點",
+                                   "軌跡示意", "請確認後方影像及周圍環境", "置中", "左", "右"),
+}
+GEAR_GLYPHS = frozenset(
+    ord(c) for c in "".join(LABELS[TRADITIONAL_CHINESE]) + "月日星期一二三四五六時分" if ord(c) > 127
+)
+# The reference dimensions are only for the display projection. Use C4's
+# detected wheelbase and steering ratio when drawing the estimated guide.
+IONIQ5 = frozenset(("HYUNDAI_IONIQ_5", "HYUNDAI_IONIQ_5_PE", "HYUNDAI_IONIQ_5_N"))
+EV6 = frozenset(("KIA_EV6", "KIA_EV6_PE"))
+DIMENSIONS = {"ioniq5": (4.64, 1.89), "ev6": (4.68, 1.88)}
+AMBER = (255, 149, 0)
+GUIDE_COLORS = ((255, 77, 70), (255, 149, 0), (60, 177, 111))
+
+
+def gear_screen(state):
+    gear = (state.gear_text or "").strip().upper()
+    return gear if state.onroad and state.gear_valid and gear in ("P", "R") else None
+
+
+def vehicle_name(fingerprint):
+    if fingerprint in IONIQ5:
+        return "ioniq5"
+    if fingerprint in EV6:
+        return "ev6"
+    return "generic"
+
+
+def reverse_track(steering_deg, wheelbase_m, steer_ratio, dimensions):
+    if steering_deg is None or wheelbase_m is None or steer_ratio is None:
+        return None
+    if not (math.isfinite(steering_deg) and 1.5 <= wheelbase_m <= 5.0 and 1.0 <= steer_ratio <= 40.0):
+        return None
+    length, width = dimensions
+    if wheelbase_m >= length:
+        return None
+    rear_overhang = (length - wheelbase_m) / 2
+    wheel_angle = max(-45.0, min(45.0, steering_deg / steer_ratio))
+    curvature = math.tan(math.radians(wheel_angle)) / wheelbase_m
+    return curvature, rear_overhang, width / 2
+
+
+def guide_point(s, side, curvature, rear_overhang):
+    if abs(curvature) < 1e-6:
+        return s, side
+    heading = curvature * s
+    lateral = -2 * math.sin(heading / 2) ** 2 / curvature - rear_overhang * math.sin(heading)
+    rearward = math.sin(heading) / curvature + rear_overhang * (math.cos(heading) - 1)
+    return rearward + side * math.sin(heading), lateral + side * math.cos(heading)
+
+
+def color(rgb, alpha=255):
+    return rl.Color(*rgb, alpha)
+
+
+class GearScreens:
+    def __init__(self):
+        self.textures = {}
+
+    def close(self):
+        for texture in self.textures.values():
+            if texture is not None:
+                rl.unload_texture(texture)
+        self.textures.clear()
+
+    def prepare(self, state, gear):
+        name = vehicle_name(state.car_fingerprint)
+        if name == "generic" or (name, gear) in self.textures:
+            return
+        path = ASSETS / f"{name}-{'park' if gear == 'P' else 'reverse'}.png"
+        texture = rl.load_texture(str(path)) if path.is_file() else None
+        if texture is not None and texture.id > 0:
+            rl.set_texture_filter(texture, rl.TextureFilter.TEXTURE_FILTER_BILINEAR)
+        else:
+            texture = None
+        self.textures[name, gear] = texture
+
+    def draw(self, renderer, state, gear):
+        palette = COLORS[renderer._current_theme().is_dark]
+        labels = LABELS.get(renderer.language, LABELS["en"])
+
+        def text(value, x, y, size, ink="text", anchor="left"):
+            renderer._draw_text(value, x, y, size, palette[ink], anchor)
+
+        name = vehicle_name(state.car_fingerprint)
+        rl.clear_background(color(palette["bottom"]))
+        rl.rl_push_matrix()
+        try:
+            rl.rl_scalef(renderer.width / DESIGN_WIDTH, renderer.height / DESIGN_HEIGHT, 1.0)
+            rl.draw_rectangle_gradient_v(0, 0, DESIGN_WIDTH, DESIGN_HEIGHT,
+                                         color(palette["top"]), color(palette["bottom"]))
+            if gear == "P":
+                self.draw_park(renderer, state, name, palette, labels, text)
+            else:
+                self.draw_reverse(renderer, state, name, palette, labels, text)
+        finally:
+            rl.rl_pop_matrix()
+
+    def draw_park(self, renderer, state, name, palette, labels, text):
+        language = renderer.language
+        now = time.localtime()
+        if language == TRADITIONAL_CHINESE:
+            date = f"{now.tm_mon}月{now.tm_mday}日 星期{'一二三四五六日'[now.tm_wday]}"
+        elif language == "ko":
+            date = f"{now.tm_mon}월 {now.tm_mday}일 {'월화수목금토일'[now.tm_wday]}요일"
+        else:
+            date = time.strftime("%a, %b %d", now)
+        text(date, 70, 92, 34, "muted")
+        text(time.strftime("%H:%M", now), 64, 185, 108)
+        text("P", 70, 340, 64, "accent")
+        text(labels.park, 132, 340, 30, "muted")
+        soc = state.fuel_gauge
+        if soc is not None and 0 <= soc <= 1 and (name != "generic" or state.energy_gauge_label == "battery"):
+            renderer._rounded_rect(236, 328, 50, 24, 6, palette["card"], palette["muted"], 2)
+            if soc > 0:
+                level = (52, 199, 89) if soc >= 0.3 else AMBER if soc >= 0.15 else GUIDE_COLORS[0]
+                renderer._rounded_rect(240, 332, max(2.0, 42 * soc), 16, 4, level)
+            text(f"{soc:.0%}", 300, 340, 33)
+
+        for layer in range(10):
+            rl.draw_ellipse(790, 405, 270 - layer * 12, 25 - layer, rl.Color(0, 0, 0, 8))
+        texture = self.textures.get((name, "P"))
+        if texture is not None:
+            width = min(630, 340 * texture.width / texture.height)
+            height = width * texture.height / texture.width
+            self.draw_texture(texture, 790 - width / 2, 405 - height, width, height)
+        else:
+            self.draw_car(renderer, 610, 160, 370, 165, palette)
+
+        self.draw_car(renderer, 1263, 226, 54, 115, palette)
+        for key, dx, dy in (("fl", -70, -29), ("fr", 70, -29), ("rl", -70, 34), ("rr", 70, 34)):
+            value = getattr(state.tpms, key, None)
+            text(f"{value:.0f}" if value is not None and 0 < value else "--",
+                 1290 + dx, 284 + dy, 30, "text", "center")
+        text(labels.tyre_pressures, 1290, 374, 22, "muted", "center")
+
+        report = state.trip_report
+        metric = renderer.is_metric
+        text(labels.this_trip, 1450, 66, 30, "muted")
+        duration = max(0, round(report.duration_s / 60)) if report else 0
+        hours, minutes = divmod(duration, 60)
+        time_value = f"{hours}時 {minutes:02d}分" if language == TRADITIONAL_CHINESE else f"{hours}:{minutes:02d}"
+        rows = (
+            ("distance", format_trip_distance(report.distance_m, metric) if report else "--"),
+            ("time", time_value if report else "--"),
+            ("average", f"{display_speed(report.average_speed_kph, metric):.1f} {speed_unit(metric)}" if report else "--"),
+            ("auto_drive", f"{report.auto_ratio_percent:.0f} %" if report else "--"),
+        )
+        for index, (label, value) in enumerate(rows):
+            y = 137 + index * 76
+            text(cluster_text(language, label), 1450, y, 28, "muted")
+            text(value, 1860, y, 38, "text", "right")
+            rl.draw_line_ex(rl.Vector2(1450, y + 34), rl.Vector2(1860, y + 34), 2, color(palette["line"]))
+        if report:
+            counts = (("hard_accel", report.hard_accel_count), ("hard_brake", report.hard_brake_count),
+                      ("hard_corner", report.hard_corner_count))
+            summary = " · ".join(f"{cluster_text(language, key)} {number}" for key, number in counts)
+            text(summary, 1450, 434, 23, "muted")
+
+    def draw_reverse(self, renderer, state, name, palette, labels, text):
+        dimensions = DIMENSIONS.get(name)
+        length, width = dimensions or (4.6, 1.85)
+        rear_x, center_y, scale = 855.0, 240.0, 84.0
+        steering_deg = state.steering_angle_deg
+        track = reverse_track(steering_deg, state.parking_wheelbase_m, state.parking_steer_ratio, dimensions) if dimensions else None
+        if track is not None:
+            curvature, overhang, half_width = track
+
+            def point(distance, side):
+                back, across = guide_point(distance, side, curvature, overhang)
+                return rl.Vector2(rear_x + back * scale, center_y - across * scale)
+
+            def line(distance_a, distance_b, side, ink):
+                rl.draw_line_ex(point(distance_a, side), point(distance_b, side), 4, ink)
+
+            rl.begin_scissor_mode(int(430 * renderer.width / DESIGN_WIDTH), int(25 * renderer.height / DESIGN_HEIGHT),
+                                  int(990 * renderer.width / DESIGN_WIDTH), int(370 * renderer.height / DESIGN_HEIGHT))
+            try:
+                for side in (-half_width, half_width):
+                    for step in range(24):
+                        line(step / 6, (step + 1) / 6, side, color(palette["accent"]))
+                for index, rgb in enumerate(GUIDE_COLORS, start=1):
+                    distance = float(index) if renderer.is_metric else index * 3 * 0.3048
+                    rl.draw_line_ex(point(distance, -half_width), point(distance, half_width), 5, color(rgb))
+                    label_point = point(distance, half_width + 0.27)
+                    label = f"{index} m" if renderer.is_metric else f"{3 * index} ft"
+                    text(label, label_point.x, label_point.y, 22, "muted", "center")
+            finally:
+                rl.end_scissor_mode()
+            text(labels.estimated_path, 1165, 425, 22, "muted", "center")
+
+        for active, sign in ((state.right_blindspot, -1), (state.left_blindspot, 1)):
+            if active:
+                y = center_y + sign * (width / 2 + 0.20) * scale
+                for band in range(4):
+                    rl.draw_rectangle(int(rear_x - length * scale), int(y + sign * 8 * band),
+                                      int(length * scale), 7, color(AMBER, 120 - band * 25))
+        texture = self.textures.get((name, "R"))
+        if texture is not None:
+            frame_width = length * scale / 0.89
+            frame_height = frame_width * texture.height / texture.width
+            self.draw_texture(texture, rear_x - (frame_width + length * scale) / 2,
+                              center_y - frame_height / 2, frame_width, frame_height)
+        else:
+            self.draw_car(renderer, rear_x - length * scale, center_y - width * scale / 2,
+                          length * scale, width * scale, palette)
+
+        text("R", 70, 146, 140)
+        text(labels.reverse, 195, 176, 34, "muted")
+        speed = display_speed(abs(state.speed_kph), renderer.is_metric)
+        text(f"{speed:.0f}", 70, 325, 84)
+        text(speed_unit(renderer.is_metric), 160 if speed < 9.5 else 206, 348, 30, "muted")
+        text(labels.steering_wheel, 1480, 104, 28, "muted")
+        steering = "--"
+        if steering_deg is not None and math.isfinite(steering_deg):
+            side = labels.left if steering_deg > 0 else labels.right
+            steering = labels.centre if abs(steering_deg) < 5 else f"{side} {abs(steering_deg):.0f}°"
+        text(steering, 1860, 104, 40, "text", "right")
+        rl.draw_line_ex(rl.Vector2(1480, 150), rl.Vector2(1860, 150), 2, color(palette["line"]))
+        text(labels.blind_spots, 1480, 207, 28, "muted")
+        for x, label, active in ((1702, labels.left, state.left_blindspot), (1792, labels.right, state.right_blindspot)):
+            rl.draw_circle(x, 207, 14, color(AMBER if active else palette["line"]))
+            text(label, x + 21, 207, 19, "text" if active else "muted")
+        reminder = renderer._ellipsize_text(labels.rear_view_reminder, 23, 395)
+        text(reminder, 1860, 420, 23, "muted", "right")
+
+    @staticmethod
+    def draw_car(renderer, x, y, width, height, palette):
+        renderer._rounded_rect(x, y, width, height, min(width, height) * 0.30, palette["card"], palette["line"], 2)
+        renderer._rounded_rect(x + width * 0.19, y + height * 0.24, width * 0.62, height * 0.52,
+                               min(width, height) * 0.16, palette["line"])
+
+    @staticmethod
+    def draw_texture(texture, x, y, width, height):
+        rl.draw_texture_pro(texture, rl.Rectangle(0, 0, texture.width, texture.height),
+                            rl.Rectangle(x, y, width, height), rl.Vector2(0, 0), 0, rl.WHITE)
